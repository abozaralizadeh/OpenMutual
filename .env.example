# Copy to .env. Everything here is for the local simulation.

# The local chain. Anything that isn't this machine is refused in code.
RPC_URL=http://127.0.0.1:8545

# Protects the Admin page. setup_service.sh makes a random one. Change this if you run it by hand.
ADMIN_TOKEN=change-me

# Lets anyone skip the simulated clock forward. Turn off for a closed test with several people.
PUBLIC_CLOCK=true

# Pretend members vote on proposals and sit on claim juries, so one person can try those flows.
# The fake AI assessors run either way.
SIMULATED_MEMBERS=true

WORKER_INTERVAL_MS=3000

# Web app port.
WEB_PORT=3417

# Optional. Only listen on this address. setup_service.sh sets 127.0.0.1 in shared mode.
# WEB_HOST=127.0.0.1

# Optional. Run the app under a path, like /openmutual/, behind nginx. It's baked into the build,
# so rebuild after changing it (setup_service.sh does).
# BASE_PATH=/openmutual/

# Optional. The chain's port. It has to match RPC_URL. setup_service.sh picks one in shared mode.
# CHAIN_PORT=8545

# Set by setup_service.sh in shared mode: the proxy in front is on 127.0.0.1. The app doesn't
# use the visitor's IP for anything today, and nginx does the per-IP rate limit.
# TRUST_PROXY=127.0.0.1

# Optional. Defaults to the public Anvil test phrase. Never put a real phrase here,
# real keys have no place in this project.
# LOCAL_MNEMONIC=
