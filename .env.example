# Copy to .env. Everything here is for the local simulation.

# The local chain. Anything that isn't this machine is refused in code.
RPC_URL=http://127.0.0.1:8545

# Protects the Admin page. setup_service.sh makes a random one. Change this if you run it by hand.
ADMIN_TOKEN=change-me

# Lets anyone skip the simulated clock forward. Turn off for a closed test with several people.
PUBLIC_CLOCK=true

# Pretend members vote on claims and proposals, so one person can try those flows.
SIMULATED_MEMBERS=true

WORKER_INTERVAL_MS=3000

# Web app port.
WEB_PORT=3417

# Optional. Defaults to the public Anvil test phrase. Never put a real phrase here,
# real keys have no place in this project.
# LOCAL_MNEMONIC=
