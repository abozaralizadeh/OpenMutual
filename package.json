{
  "name": "openmutual",
  "version": "0.1.0",
  "private": true,
  "description": "A simulation of a distributed mutual. Test money on a local chain only.",
  "engines": { "node": ">=24" },
  "workspaces": ["shared", "worker", "web"],
  "scripts": {
    "chain": "bash scripts/chain.sh",
    "deploy": "bash scripts/deploy.sh",
    "dev:web": "npm run dev -w web",
    "dev:worker": "npm run dev -w worker",
    "dev": "bash scripts/dev.sh",
    "build": "npm run build -w web",
    "test": "bash scripts/test-all.sh",
    "test:contracts": "cd contracts && npx forge test",
    "test:shared": "npm test -w shared",
    "test:worker": "npm test -w worker",
    "test:e2e": "npm run e2e -w web",
    "simulate": "npm run simulate -w worker"
  },
  "devDependencies": {
    "@foundry-rs/anvil": "1.7.1",
    "@foundry-rs/forge": "1.7.1",
    "@openzeppelin/contracts": "5.6.1",
    "forge-std": "https://github.com/foundry-rs/forge-std/archive/refs/tags/v1.9.7.tar.gz",
    "typescript": "^5.9.0"
  }
}
